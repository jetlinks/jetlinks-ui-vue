{
  "include": [
    "./**/*.ts",
    "./**/*.tsx",
    "./**/*.vue",
    "./**/*.json",
    "../../jetlinks-web-core/src/auto-imports.d.ts"
  ],
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "types": [
      "ant-design-vue/typings/global",
      "vite/client"
    ],
    "suppressImplicitAnyIndexErrors": true,
    "baseUrl": "./",
    "paths": {
      "@jetlinks-web-core/*": [
        "../../jetlinks-web-core/src/*"
      ],
      "@device-manager-ui/*": [
        "./*"
      ]
    }
  }
}
